# Copy this file to .env.local and fill in your own key.
# .env.local is git-ignored, so your key never reaches GitHub.

# Required for the "Read link" auto-fill feature.
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional. Which model does the parsing.
# Haiku is the cheapest and is plenty for pulling fields out of a job post.
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
