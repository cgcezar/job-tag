# Copy this file to .env.local and fill it in.
# .env.local is git-ignored, so your key never reaches GitHub.

# Which service does the parsing: "nvidia" (free) or "anthropic" (paid).
PARSER_PROVIDER=nvidia

# --- NVIDIA, the free option -------------------------------------------
# Free key from https://build.nvidia.com, starts with nvapi-
NVIDIA_API_KEY=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

# Optional. Copy the exact model ID from that model's page on build.nvidia.com.
# The catalog changes, so a stale ID here gives you a 404.
NVIDIA_MODEL=deepseek-ai/deepseek-v4-flash-0731

# --- Anthropic, only if PARSER_PROVIDER=anthropic ------------------------
# ANTHROPIC_API_KEY=sk-ant-your-key-here
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001
